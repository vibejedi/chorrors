{
	"appId": "com.skullhotel.app",
	"productName": "Cleaning Horrors",
	"directories": {
		"output": "dist"
	},
	"files": ["build/**/*", "electron/**/*", "package.json"],
	"extraResources": [{ "from": "build", "to": "app/build" }],
	"win": {
		"target": "nsis",
		"icon": null,
		"requestedExecutionLevel": "asInvoker",
		"applicationManifest": "electron/app.manifest"
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"createDesktopShortcut": true,
		"createStartMenuShortcut": true,
		"shortcutName": "Cleaning Horrors"
	}
}
